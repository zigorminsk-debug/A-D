<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Таблетки»: один прокручиваемый список.
     Шапка (подсказка и кнопка сигнала) и история приёмов — его же элементы,
     поэтому список препаратов прокручивается и добавленный препарат всегда видно. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/medsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="96dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/add_med"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary"
        app:tint="@color/onPrimary" />
</FrameLayout>
